<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Managed by ansible (roles/samba). Local edits will be overwritten on the next playbook run. -->
<service-group>
  <name replace-wildcards="yes">%h</name>
  <service>
    <type>_smb._tcp</type>
    <port>445</port>
  </service>
  <service>
    <type>_device-info._tcp</type>
    <port>0</port>
    <txt-record>model=RackMac</txt-record>
  </service>
  <!-- dk0's adVN names the Time Machine share (samba_timemachine_share_name); adVF=0x82 is
       the flag that tells macOS this disk is a valid Time Machine destination, making it show
       up under System Settings -> Time Machine -> Add Backup Disk without a manual connect. -->
  <service>
    <type>_adisk._tcp</type>
    <port>9</port>
    <txt-record>sys=waMa=0,adVF=0x100</txt-record>
    <txt-record>dk0=adVN={{ samba_timemachine_share_name }},adVF=0x82</txt-record>
  </service>
</service-group>
